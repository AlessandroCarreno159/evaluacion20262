@model List<SolicitudServicio>
@{
    ViewData["Title"] = "Registrar Solicitud de Servicio";
}

<h1 class="mb-4">Registrar Nueva Solicitud de Servicio</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">Datos de la solicitud</div>
            <div class="card-body">
                <form asp-controller="Solicitudes" asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="@(new SolicitudServicio().Cliente)" class="form-label"></label>
                        <input name="Cliente" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="@(new SolicitudServicio().Telefono)" class="form-label"></label>
                        <input name="Telefono" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="@(new SolicitudServicio().Distrito)" class="form-label"></label>
                        <input name="Distrito" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="@(new SolicitudServicio().TipoServicio)" class="form-label"></label>
                        <select name="TipoServicio" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            <option value="Instalación">Instalación</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                            <option value="Revisión">Revisión</option>
                            <option value="Fuga">Fuga</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="@(new SolicitudServicio().Descripcion)" class="form-label"></label>
                        <textarea name="Descripcion" class="form-control" rows="3"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Guardar solicitud</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">Solicitudes registradas</div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Distrito</th>
                                <th>Tipo</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td>@s.Cliente</td>
                                    <td>@s.Distrito</td>
                                    <td>@s.TipoServicio</td>
                                    <td>@s.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">Aún no hay solicitudes registradas.</p>
                }
            </div>
        </div>
    </div>
</div>
